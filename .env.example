# Abstract API keys, one per product. Each product has a free plan.
# Get them at https://app.abstractapi.com/?utm_source=vercel&utm_medium=template&utm_campaign=abstract-api-vercel-template
# A product without a key is skipped: the signup still gets a verdict from the others.

# Email Intelligence: deliverability, disposable and risk signals for the email address.
ABSTRACT_EMAIL_INTELLIGENCE_API_KEY=

# Phone Intelligence: validity, line type, VoIP and risk for the phone number.
ABSTRACT_PHONE_INTELLIGENCE_API_KEY=

# IP Intelligence: VPN, proxy, Tor and hosting detection for the visitor's IP address.
ABSTRACT_IP_INTELLIGENCE_API_KEY=

# Optional. Shows sample inputs and an IP address field. Always on in `next dev`.
# Never enable it on a real signup page: visitors could choose the IP the check sees.
# ABSTRACT_TEST_MODE=true

# Optional. Cloudflare Turnstile bot check, on only when both are set.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
